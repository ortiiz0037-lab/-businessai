NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key

# SOLO en el servidor: la usa el webhook de Stripe (src/app/api/stripe/webhook)
# y los tests de RLS (tests/rls.test.ts). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app, sin barra final (p. ej. https://tu-dominio.com).
# Se usa para las URLs de retorno de Stripe Checkout.
NEXT_PUBLIC_APP_URL=

# Entorno: development | staging | production (ver docs/ENVIRONMENTS.md).
# Fuera de production solo se aceptan claves de Stripe de TEST; en
# production solo LIVE.
APP_ENV=development

# Stripe (solo servidor). Los precios se buscan por lookup key
# (businessai_<plan>_monthly); STRIPE_PRICE_ID ya no se usa.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SOLO tests de RLS contra Supabase (tests/rls-business.test.ts): ref del
# proyecto de DESARROLLO (subdominio de NEXT_PUBLIC_SUPABASE_URL). Si no
# coincide con la URL, los tests no se ejecutan.
RLS_TEST_PROJECT_REF=

# Asistente BusinessAI / Intelligence Engine (solo servidor; ver docs/INTELLIGENCE.md).
# Cerrado por defecto: sin ANTHROPIC_API_KEY y ASSISTANT_SERVER_KEYS no arranca.
# ASSISTANT_SERVER_KEYS="<id>:<base64 de 32+ bytes aleatorios>" — la misma clave se
# registra en la base de datos con public.assistant_set_server_key(<id>, <base64>).
ANTHROPIC_API_KEY=
ASSISTANT_SERVER_KEYS=
# Opcionales: ASSISTANT_MODEL (modelo registrado), ASSISTANT_ROUTER=off,
# ASSISTANT_TURN_DEADLINE_MS (10000–55000), ASSISTANT_DISABLED=1
