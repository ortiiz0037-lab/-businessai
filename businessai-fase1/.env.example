NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key

# SOLO en el servidor: la usa el webhook de Stripe (src/app/api/stripe/webhook)
# y los tests de RLS (tests/rls.test.ts). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app, sin barra final (p. ej. https://tu-dominio.com).
# Se usa para las URLs de retorno de Stripe Checkout.
NEXT_PUBLIC_APP_URL=

# Stripe (solo servidor). Usa claves de modo test en previews.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
