
import { redirect } from 'next/navigation'
import { createClient } from '@/lib/supabase/server'

type PaymentRow = {
  id: string
  document_id: string
  amount: number | null
  payment_method: string | null
  reference: string | null
  paid_at: string
  created_at: string
}

type DocumentRow = {
  id: string
  document_number: string | null
  title: string | null
  client_id: string | null
}

type ClientRow = {
  id: string
  name: string | null
  business_name: string | null
}

function money(value: number | null | undefined) {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
  }).format(Number(value ?? 0))
}

function formatDate(value: string | null | undefined) {
  if (!value) return '—'

  const date = new Date(value)

  if (Number.isNaN(date.getTime())) return '—'

  return new Intl.DateTimeFormat('es-PR', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(date)
}

function paymentMethodLabel(value: string | null) {
  if (!value) return 'No especificado'

  const methods: Record<string, string> = {
    manual: 'Manual',
    cash: 'Efectivo',
    card: 'Tarjeta',
    transfer: 'Transferencia',
    check: 'Cheque',
    other: 'Otro',
  }

  return methods[value] ?? value
}

function SummaryCard({
  label,
  value,
  description,
  icon,
  accent,
}: {
  label: string
  value: string
  description: string
  icon: string
  accent: 'blue' | 'violet' | 'emerald'
}) {
  const accents = {
    blue: 'bg-blue-50 text-blue-700 ring-blue-100',
    violet: 'bg-violet-50 text-violet-700 ring-violet-100',
    emerald: 'bg-emerald-50 text-emerald-700 ring-emerald-100',
  }

  return (
    <article className="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/50 sm:p-6">
      <div className="flex items-start justify-between gap-3">
        <div>
          <p className="text-sm font-medium text-slate-500">{label}</p>
          <p className="mt-3 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
            {value}
          </p>
        </div>

        <div
          className={`flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl text-xl ring-1 ${accents[accent]}`}
          aria-hidden="true"
        >
          {icon}
        </div>
      </div>

      <p className="mt-4 text-xs leading-5 text-slate-500">
        {description}
      </p>

      <div
        className={`absolute inset-x-0 bottom-0 h-0.5 opacity-70 ${
          accent === 'blue'
            ? 'bg-gradient-to-r from-blue-500 to-cyan-300'
            : accent === 'violet'
              ? 'bg-gradient-to-r from-violet-500 to-fuchsia-300'
              : 'bg-gradient-to-r from-emerald-500 to-teal-300'
        }`}
      />
    </article>
  )
}

export default async function PaymentsPage() {
  const supabase = await createClient()

  const {
    data: { user },
  } = await supabase.auth.getUser()

  if (!user) {
    redirect('/login')
  }

  const { data: member } = await supabase
    .from('memberships')
    .select('company_id')
    .eq('user_id', user.id)
    .limit(1)
    .maybeSingle()

  if (!member?.company_id) {
    redirect('/dashboard')
  }

  const companyId = member.company_id

  const { data: payments, error } = await supabase
    .from('payments')
    .select(
      'id, document_id, amount, payment_method, reference, paid_at, created_at'
    )
    .eq('company_id', companyId)
    .order('paid_at', { ascending: false })

  if (error) {
    console.error('PAYMENTS_LOAD_ERROR', error)
  }

  const paymentRows = (payments ?? []) as PaymentRow[]

  const documentIds = [
    ...new Set(
      paymentRows
        .map((payment) => payment.document_id)
        .filter(Boolean)
    ),
  ]

  let documents: DocumentRow[] = []

  if (documentIds.length > 0) {
    const { data: documentData } = await supabase
      .from('documents')
      .select('id, document_number, title, client_id')
      .eq('company_id', companyId)
      .in('id', documentIds)

    documents = (documentData ?? []) as DocumentRow[]
  }

  const clientIds = [
    ...new Set(
      documents
        .map((document) => document.client_id)
        .filter(Boolean)
    ),
  ]

  let clients: ClientRow[] = []

  if (clientIds.length > 0) {
    const { data: clientData } = await supabase
      .from('clients')
      .select('id, name, business_name')
      .eq('company_id', companyId)
      .in('id', clientIds)

    clients = (clientData ?? []) as ClientRow[]
  }

  const documentMap = new Map(
    documents.map((document) => [document.id, document])
  )

  const clientMap = new Map(
    clients.map((client) => [client.id, client])
  )

  const totalCollected = paymentRows.reduce(
    (sum, payment) => sum + Number(payment.amount ?? 0),
    0
  )

  const paymentCount = paymentRows.length

  const now = new Date()
  const currentYear = now.getFullYear()
  const currentMonthNumber = now.getMonth()

  const collectedThisMonth = paymentRows
    .filter((payment) => {
      const date = new Date(payment.paid_at)

      return (
        !Number.isNaN(date.getTime()) &&
        date.getFullYear() === currentYear &&
        date.getMonth() === currentMonthNumber
      )
    })
    .reduce((sum, payment) => sum + Number(payment.amount ?? 0), 0)

  return (
    <main className="min-h-screen bg-[#f5f7fc] text-slate-900">
      <div className="mx-auto max-w-[1500px] px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
        <header className="relative mb-8 overflow-hidden rounded-3xl bg-gradient-to-br from-[#091426] via-[#11254b] to-[#243f85] p-6 text-white shadow-xl shadow-blue-950/10 sm:p-9">
          <div
            className="pointer-events-none absolute -right-12 -top-20 h-64 w-64 rounded-full bg-blue-400/15 blur-3xl"
            aria-hidden="true"
          />
          <div
            className="pointer-events-none absolute -bottom-28 right-1/3 h-56 w-56 rounded-full bg-violet-400/15 blur-3xl"
            aria-hidden="true"
          />

          <div className="relative flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <div className="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.07] px-3 py-1.5 text-xs font-semibold tracking-wide text-blue-100">
                <span className="h-2 w-2 rounded-full bg-emerald-400" />
                BUSINESSAI / FINANZAS
              </div>

              <h1 className="text-3xl font-bold tracking-tight sm:text-4xl">
                Pagos y cobros
              </h1>

              <p className="mt-3 max-w-xl text-sm leading-6 text-blue-100/85 sm:text-base">
                Todo lo que tu empresa ha recibido, organizado y conectado
                con sus documentos.
              </p>
            </div>

            <a
              href="/documents"
              className="inline-flex min-h-12 w-fit items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/10 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-white/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
            >
              <span aria-hidden="true">↗</span>
              Ver documentos
            </a>
          </div>

          <div className="relative mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-white/10 pt-5 text-xs text-blue-100/75">
            <span className="inline-flex items-center gap-2">
              <span aria-hidden="true">◈</span>
              Historial de transacciones
            </span>
            <span className="inline-flex items-center gap-2">
              <span aria-hidden="true">✓</span>
              Datos de tu empresa
            </span>
          </div>
        </header>

        <section
          aria-label="Resumen de pagos"
          className="mb-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3"
        >
          <SummaryCard
            label="Total cobrado"
            value={money(totalCollected)}
            description="Importe total de los pagos registrados"
            icon="$"
            accent="blue"
          />

          <SummaryCard
            label="Cobrado este mes"
            value={money(collectedThisMonth)}
            description="Pagos registrados durante el mes actual"
            icon="↗"
            accent="violet"
          />

          <SummaryCard
            label="Pagos registrados"
            value={paymentCount.toLocaleString('es-PR')}
            description="Transacciones encontradas en el historial"
            icon="▤"
            accent="emerald"
          />
        </section>

        <section className="overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-sm shadow-slate-200/40">
          <div className="flex flex-col gap-4 border-b border-slate-100 p-5 sm:flex-row sm:items-center sm:justify-between sm:px-7 sm:py-6">
            <div>
              <div className="flex items-center gap-3">
                <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-lg text-blue-700">
                  ▤
                </div>
                <div>
                  <h2 className="text-lg font-bold tracking-tight text-slate-950 sm:text-xl">
                    Historial de pagos
                  </h2>
                  <p className="mt-1 text-sm text-slate-500">
                    Consulta los importes, clientes y facturas asociadas.
                  </p>
                </div>
              </div>
            </div>

            <span className="inline-flex w-fit items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-600">
              <span className="h-1.5 w-1.5 rounded-full bg-emerald-500" />
              {paymentCount} {paymentCount === 1 ? 'transacción' : 'transacciones'}
            </span>
          </div>

          {error ? (
            <div className="m-5 rounded-2xl border border-red-200 bg-red-50 p-5 sm:m-7">
              <h3 className="font-semibold text-red-900">
                No se pudo cargar el historial de pagos
              </h3>
              <p className="mt-1 text-sm leading-6 text-red-800">
                Intenta recargar la página. Si el problema continúa,
                revisa la conexión con la base de datos.
              </p>
            </div>
          ) : paymentRows.length === 0 ? (
            <div className="px-6 py-16 text-center sm:py-20">
              <div className="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-blue-100 bg-gradient-to-br from-blue-50 to-violet-50 text-3xl shadow-sm">
                $
              </div>

              <h3 className="mt-5 text-lg font-bold tracking-tight text-slate-950">
                Tu historial está listo para comenzar
              </h3>

              <p className="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
                Cuando existan pagos registrados para tu empresa,
                aparecerán aquí con sus importes, métodos y facturas.
              </p>

              <a
                href="/documents"
                className="mt-6 inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
              >
                Ir a documentos
                <span aria-hidden="true">→</span>
              </a>
            </div>
          ) : (
            <>
              <div className="hidden overflow-x-auto md:block">
                <table className="w-full min-w-[850px] border-collapse text-left">
                  <thead>
                    <tr className="border-b border-slate-100 bg-slate-50/80">
                      <th className="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-slate-500">
                        Fecha
                      </th>
                      <th className="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-slate-500">
                        Cliente
                      </th>
                      <th className="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-slate-500">
                        Factura
                      </th>
                      <th className="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-slate-500">
                        Método
                      </th>
                      <th className="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">
                        Importe
                      </th>
                      <th className="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">
                        Detalle
                      </th>
                    </tr>
                  </thead>

                  <tbody className="divide-y divide-slate-100">
                    {paymentRows.map((payment) => {
                      const document = documentMap.get(payment.document_id)
                      const client = document?.client_id
                        ? clientMap.get(document.client_id)
                        : undefined

                      const clientName =
                        client?.business_name ||
                        client?.name ||
                        'Cliente no disponible'

                      return (
                        <tr
                          key={payment.id}
                          className="group transition-colors hover:bg-blue-50/40"
                        >
                          <td className="whitespace-nowrap px-6 py-5 text-sm text-slate-600">
                            {formatDate(payment.paid_at)}
                          </td>

                          <td className="px-6 py-5">
                            <p className="max-w-[220px] truncate text-sm font-semibold text-slate-900">
                              {clientName}
                            </p>
                            {client?.business_name && client.name && (
                              <p className="mt-1 max-w-[220px] truncate text-xs text-slate-500">
                                {client.name}
                              </p>
                            )}
                            <p className="mt-1 text-xs text-slate-400">
                              Ref. {payment.reference || '—'}
                            </p>
                          </td>

                          <td className="px-6 py-5">
                            <a
                              href={`/documents/${payment.document_id}`}
                              className="text-sm font-semibold text-blue-700 underline-offset-4 transition hover:text-blue-900 hover:underline"
                            >
                              {document?.document_number ||
                                document?.title ||
                                'Ver factura'}
                            </a>
                          </td>

                          <td className="px-6 py-5">
                            <span className="inline-flex items-center gap-2 rounded-lg border border-slate-200/80 bg-white px-3 py-2 text-xs font-medium text-slate-700">
                              <span
                                className="h-1.5 w-1.5 rounded-full bg-blue-500"
                                aria-hidden="true"
                              />
                              {paymentMethodLabel(payment.payment_method)}
                            </span>
                          </td>

                          <td className="whitespace-nowrap px-6 py-5 text-right">
                            <span className="text-sm font-bold tabular-nums text-slate-950">
                              {money(payment.amount)}
                            </span>
                          </td>

                          <td className="whitespace-nowrap px-6 py-5 text-right">
                            <a
                              href={`/documents/${payment.document_id}`}
                              aria-label={`Ver factura de ${clientName}`}
                              className="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700"
                            >
                              Ver detalle →
                            </a>
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
              </div>

              <div className="divide-y divide-slate-100 md:hidden">
                {paymentRows.map((payment) => {
                  const document = documentMap.get(payment.document_id)
                  const client = document?.client_id
                    ? clientMap.get(document.client_id)
                    : undefined

                  const clientName =
                    client?.business_name ||
                    client?.name ||
                    'Cliente no disponible'

                  return (
                    <article key={payment.id} className="p-5 sm:p-6">
                      <div className="flex items-start justify-between gap-4">
                        <div className="min-w-0">
                          <p className="truncate text-sm font-bold text-slate-950">
                            {clientName}
                          </p>
                          <p className="mt-1 text-xs text-slate-500">
                            {formatDate(payment.paid_at)}
                          </p>
                        </div>

                        <p className="shrink-0 text-lg font-bold tracking-tight text-slate-950">
                          {money(payment.amount)}
                        </p>
                      </div>

                      <div className="mt-4 grid grid-cols-2 gap-3">
                        <div className="rounded-xl bg-slate-50 p-3">
                          <p className="text-[11px] font-semibold uppercase tracking-wide text-slate-400">
                            Método
                          </p>
                          <p className="mt-1 break-words text-xs font-semibold text-slate-700">
                            {paymentMethodLabel(payment.payment_method)}
                          </p>
                        </div>

                        <div className="rounded-xl bg-slate-50 p-3">
                          <p className="text-[11px] font-semibold uppercase tracking-wide text-slate-400">
                            Factura
                          </p>
                          <p className="mt-1 break-words text-xs font-semibold text-slate-700">
                            {document?.document_number ||
                              document?.title ||
                              'No disponible'}
                          </p>
                        </div>
                      </div>

                      {payment.reference && (
                        <p className="mt-3 break-words text-xs text-slate-500">
                          Referencia: {payment.reference}
                        </p>
                      )}

                      <a
                        href={`/documents/${payment.document_id}`}
                        className="mt-4 inline-flex min-h-10 w-full items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-blue-700 transition hover:bg-blue-50"
                      >
                        Ver factura →
                      </a>
                    </article>
                  )
                })}
              </div>

              <footer className="flex flex-col gap-2 border-t border-slate-100 bg-slate-50/70 px-5 py-4 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-7">
                <span>
                  Mostrando {paymentCount} {paymentCount === 1 ? 'pago registrado' : 'pagos registrados'}
                </span>
                <span className="inline-flex items-center gap-2">
                  <span className="h-2 w-2 rounded-full bg-emerald-500" />
                  Historial de tu empresa
                </span>
              </footer>
            </>
          )}
        </section>

        <p className="mt-5 text-center text-xs text-slate-400">
          BusinessAI · Gestión financiera de tu negocio
        </p>
      </div>
    </main>
  )
}
